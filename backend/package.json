{
  "name": "@ordertaker/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "npm run test:types && node --import tsx --import ./test/test-env.ts --test --test-concurrency=1 ./test/phase7.test.ts",
    "test:types": "tsc -p test/tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npm run db:deploy",
    "db:deploy": "tsx scripts/db-deploy.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.4.0",
    "postgres": "3.4.7",
    "socket.io": "^4.8.4",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^22.16.5",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
