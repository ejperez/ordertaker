{
  "name": "ordertaker-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @ordertaker/backend\" \"npm run dev -w @ordertaker/frontend\"",
    "build": "npm run build -w @ordertaker/backend && npm run build -w @ordertaker/frontend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate -w @ordertaker/backend",
    "db:migrate": "npm run db:migrate -w @ordertaker/backend",
    "db:seed": "npm run db:seed -w @ordertaker/backend"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.14.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.36.0"
  }
}
